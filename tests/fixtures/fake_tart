#!/usr/bin/env python3
"""Stateful VM fixture; guest commands are recorded and can fail by phase.

The script under test starts `tart run` detached and keeps calling the fake
meanwhile, so calls overlap (#376). Each call holds one exclusive lock over its
read-modify-write of vms.json, and replaces the file whole, so a lock-free
reader (the spec) never sees it torn. As with real tart, `exec` needs the VM
running, so a readiness loop waits for a slow `run` instead of racing it."""
import fcntl
import json
import os
import pathlib
import sys
import time
root = pathlib.Path(os.environ['FAKE_TART_STATE'])
root.mkdir(parents=True, exist_ok=True)
statefile = root / 'vms.json'
args = sys.argv[1:]
# A slow detached `run`, as a loaded machine makes it (#376).
if args[:1] == ['run'] and os.getenv('FAKE_TART_RUN_DELAY'):
    time.sleep(float(os.environ['FAKE_TART_RUN_DELAY']))
lock = (root / 'vms.lock').open('w')
fcntl.flock(lock, fcntl.LOCK_EX)
state = json.loads(statefile.read_text()) if statefile.exists() else {'tools-test': 'running'}
with (root / 'calls.jsonl').open('a') as log:
    log.write(json.dumps({'args': args, 'no_prune': os.getenv('TART_NO_AUTO_PRUNE')}) + '\n')
command = args[0]
if os.getenv('FAKE_TART_FAIL') == command or (command == 'delete' and os.getenv('FAKE_TART_DELETE_FAIL')):
    sys.exit(1)
if command == 'list':
    print(json.dumps([{'Name': name, 'State': status} for name, status in state.items()]))
elif command == 'clone':
    assert args[2] not in state
    state[args[2]] = 'stopped'
elif command == 'run':
    state[args[-1]] = 'running'
elif command == 'stop':
    assert args[1] != 'tools-test'
    if args[1] not in state:
        sys.exit(2)
    state[args[1]] = 'stopped'
elif command == 'delete':
    assert args[1] != 'tools-test'
    if args[1] not in state:
        sys.exit(2)
    state.pop(args[1], None)
elif command == 'exec':
    if state.get(args[1]) != 'running':
        sys.exit(1)
    script = ' '.join(args[2:])
    if 'cat "$HOME/.parley-acceptance/boot.json"' in script:
        print(json.dumps({'boot': True, 'containment': True, 'decoy_unchanged': True}))
    if 'cat "$HOME/.parley-acceptance/upgrade/upgrade.json"' in script:
        print(json.dumps({'status': 'passed', 'versions': ['0.0.1', '0.0.2'], 'edited_init_sha256': 'a' * 64,
                          'candidate_b_sha256': 'b' * 64, 'decoy_unchanged': True, 'public_restored': True}))
    if 'cat "$HOME/.parley-acceptance/uninstall.json"' in script:
        print(json.dumps({'status': 'passed', 'package_removed': True, 'profile_roots_removed': ['cache', 'config', 'data', 'state'],
                          'owned_proxy_absent': True, 'decoy_unchanged': True}))
    if 'PARLEY_VM_PHASE=' in ' '.join(args):
        status = os.getenv('FAKE_TART_PROBE_STATUS', 'auth_pending')
        print(json.dumps({'status': status, 'managed_route': True, 'response_nonempty': True, 'image_sent': True, 'fake': True, 'first_use': True}))
        sys.exit(75 if status == 'auth_pending' else 1 if status == 'failed' else 0)
    if os.getenv('FAKE_TART_FAIL') and os.environ['FAKE_TART_FAIL'] in ' '.join(args[2:]):
        sys.exit(1)
else:
    sys.exit(2)
staged = root / ('vms.json.%d' % os.getpid())
staged.write_text(json.dumps(state))
# A spec seam: hold the lock, the new state staged and unpublished, until the
# named file exists, so a spec can overlap a second call or read meanwhile.
hold = os.getenv('FAKE_TART_HOLD')
if hold:
    pathlib.Path(hold + '.held').touch()
    while not os.path.exists(hold):
        time.sleep(0.01)
os.replace(staged, statefile)
