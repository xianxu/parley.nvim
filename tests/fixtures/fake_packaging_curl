#!/usr/bin/env python3
"""Filesystem archive service: URL paths address stored release archives."""
import os
import shutil
import sys
from urllib.parse import urlparse
args = sys.argv[1:]
try:
    output = args[args.index('--output') + 1]
    url = urlparse(args[-1])
    if url.netloc != 'github.com' or not url.path.startswith('/xianxu/parley.nvim/archive/refs/tags/'):
        raise ValueError('unknown archive')
    shutil.copyfile(os.path.join(os.environ['PACKAGING_ARCHIVES'], os.path.basename(url.path)), output)
except (ValueError, OSError) as error:
    print(str(error), file=sys.stderr)
    sys.exit(22)
