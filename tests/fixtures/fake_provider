#!/usr/bin/env python3
"""A stateful fake chat provider behind the real curl seam (#242, ARCH-MOCK).

A thin shell over sse_dialects: it answers the dialect's chat route with the
bytes the real API streams, chooses the reply from the REQUEST
(sse_dialects.behaviour), and adds the failure shapes a recording cannot show.

  fake_provider --dialect anthropic --port N [--mode M] [--split S]

  --mode   ok | http_<status> | http_<status>_once | inband_error[_empty] |
           cap[_empty] | no_stop | thinking | disconnect_after:<bytes>
  --split  none | every_byte | frames | random:<seed>   (the write boundaries)

An unknown mode or split is refused at startup (sse_dialects.check_mode), so a
typo fails loudly instead of serving a passing text stream.

$PARLEY_FAKE_REQUEST_LOG, when set, receives one JSON line per request
({path, body}); the spec that sets it owns and deletes it.
"""
import argparse
import http.server
import json
import os
import sys

sys.dont_write_bytecode = True  # never write __pycache__ into the repo (#202)
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import sse_dialects  # noqa: E402
from loopback_http import LoopbackHTTPServer  # noqa: E402

ROUTES = {"anthropic": ("/v1/messages",)}

parser = argparse.ArgumentParser()
parser.add_argument("--dialect", required=True, choices=sorted(sse_dialects.DIALECTS))
parser.add_argument("--port", type=int, required=True)
parser.add_argument("--mode", default="ok", type=sse_dialects.check_mode)
parser.add_argument("--split", default="none", type=sse_dialects.check_split)
args = parser.parse_args()
served = {"n": 0}


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, _format, *_args):
        pass

    def _plain(self, status, body, content_type="application/json"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b""
        served["n"] += 1
        log = os.environ.get("PARLEY_FAKE_REQUEST_LOG")
        if log:
            with open(log, "a", encoding="utf-8") as f:
                f.write(json.dumps({"path": self.path, "body": raw.decode("utf-8", "replace")}) + "\n")
        if self.path.split("?", 1)[0] not in ROUTES[args.dialect]:
            self._plain(404, b"")
            return
        mode = args.mode
        if mode.startswith("http_"):
            status_part = mode[5:]
            once = status_part.endswith("_once")
            status = int(status_part[:-5] if once else status_part)
            if not once or served["n"] == 1:
                self._plain(status, sse_dialects.ERROR_BODIES[args.dialect](status))
                return
            mode = "ok"
        try:
            request = json.loads(raw or b"{}")
        except ValueError:
            request = {}
        body = sse_dialects.DIALECTS[args.dialect](sse_dialects.behaviour(request, mode))
        cut = None
        if mode.startswith("disconnect_after:"):
            cut = int(mode.split(":", 1)[1])
            body = body[:cut]
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Connection", "close")
        if cut is None:
            self.send_header("Content-Length", str(len(body)))
        else:
            # Promise more than is sent, so curl sees a truncated transfer.
            self.send_header("Content-Length", str(len(body) + 4096))
        self.end_headers()
        for piece in sse_dialects.split(body, args.split):
            self.wfile.write(piece)
            self.wfile.flush()
        self.close_connection = True


with LoopbackHTTPServer(("127.0.0.1", args.port), Handler) as server:
    server.serve_forever()
