#!/usr/bin/env python3
"""Process-level fake of cliproxyapi for issue #131 lifecycle tests.

A real subprocess speaking the `/v1/models` identity protocol parley probes,
so the lifecycle tests exercise spawn / health-probe / reuse against an actual
HTTP server rather than function mocks (AGENTS.md external-service rule).

Invocation mirrors the real binary closely enough for the module to spawn it:
    fake_cliproxy -config <path.yaml>        # reads `port` from the JSON config
    fake_cliproxy --port <p> [--mode <m>]    # direct, for health_probe tests

Mode is taken from --mode or the PARLEY_FAKE_MODE env var (default: healthy),
so the module's spawn path (which only passes `-config <path>`) can still
select a behavior by setting the env before spawning.

Modes:
  healthy              200 {"object":"list","data":[ …mixed-owner ids… ]}
  needs_login          200 {"object":"list","data":[]}
  client_key_mismatch  401
  foreign              200 {"hello":"i am not cliproxy"}
  slow                 accept the connection, never respond
  crash                exit(1) immediately on startup

Error modes (--error-mode / PARLEY_FAKE_ERROR_MODE) select what
POST /v1/chat/completions answers, using the REAL bodies 7.1.71 emitted during
the #197 outage:
  ok                   200, a minimal completion
  no_auth              503 auth_unavailable (providers=…, model=…)
  expired              401 authentication_error, OAuth access token has expired
  quota                402 payment_required
  <mode>_once          that error on the FIRST request, 200 thereafter — a
                       genuinely transient failure for the retry rung

Login modes (PARLEY_FAKE_LOGIN_MODE), used when invoked with a -*-login flag —
the four ways #197's login could end:
  success              print the authorize URL, then write a credential
  port_taken           hold :54545 so the preflight has something to find
  dies_early           print the URL, then exit non-zero (the #197 failure)
  hangs                print the URL and never write a credential
"""
import json
import os
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer


def parse_args(argv):
    port = None
    mode = os.environ.get("PARLEY_FAKE_MODE", "healthy")
    # Management key comes from the rendered config, exactly as the real binary
    # takes it. When it is absent the management routes are NOT registered —
    # cliproxy 7.1.71 answers 404, and parley keys its "this proxy predates the
    # key, restart it" repair off precisely that (issue #197).
    mgmt_key = None
    auth_store = os.environ.get("PARLEY_FAKE_AUTH_STORE")
    error_mode = os.environ.get("PARLEY_FAKE_ERROR_MODE", "ok")
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-config", "--config"):
            with open(argv[i + 1]) as f:
                cfg = json.load(f)
            port = int(cfg.get("port"))
            mgmt_key = (cfg.get("remote-management") or {}).get("secret-key")
            auth_store = cfg.get("auth-dir") or auth_store
            i += 2
        elif a == "--port":
            port = int(argv[i + 1])
            i += 2
        elif a == "--mode":
            mode = argv[i + 1]
            i += 2
        elif a == "--management-key":
            mgmt_key = argv[i + 1]
            i += 2
        elif a == "--auth-store":
            auth_store = argv[i + 1]
            i += 2
        elif a == "--error-mode":
            error_mode = argv[i + 1]
            i += 2
        else:
            i += 1
    return port, mode, mgmt_key, auth_store, error_mode


# When the proxy last LOADED each credential into memory, keyed by filename.
# The real binary advances this only when its watcher actually reloads the file
# — a touch-only write advances `modtime` alone, and that difference IS the
# missed-reload signal parley's restart rung reads. Modelling load time as
# "first time we saw this content" makes the fake honest about it.
_LOADED = {}


def read_auth_store(auth_store):
    """Build management records from a portable folder of credential files.

    The store IS the state: a folder of `<channel>-<account>.json` credential
    files plus an optional `state.json` overlay keyed by channel, e.g.
    {"claude": {"status": "error", "status_message": "...", "unavailable": true}}.
    Tests mutate those files between calls, so the double is stateful across
    requests rather than a fixed canned reply (AGENTS.md external-service rule).
    """
    if not auth_store or not os.path.isdir(auth_store):
        return []
    overlay = {}
    overlay_path = os.path.join(auth_store, "state.json")
    if os.path.exists(overlay_path):
        with open(overlay_path) as f:
            overlay = json.load(f)
    files = []
    for name in sorted(os.listdir(auth_store)):
        if not name.endswith(".json") or name == "state.json":
            continue
        path = os.path.join(auth_store, name)
        with open(path) as f:
            raw = f.read()
        cred = json.loads(raw)
        # Load time advances only on a CONTENT change, mirroring the watcher.
        prev = _LOADED.get(name)
        if prev is None or prev[0] != raw:
            _LOADED[name] = (raw, time.time())
        loaded_at = _LOADED[name][1]
        channel = cred.get("type") or name.split("-", 1)[0]
        account = cred.get("email") or name
        record = {
            "account": account,
            "account_type": "oauth",
            "auth_index": name,
            "disabled": False,
            "email": account,
            "failed": 0,
            "id": name,
            "label": account,
            "modtime": time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(os.path.getmtime(path))),
            "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(loaded_at)),
            "name": name,
            "path": path,
            "provider": channel,
            "runtime_only": False,
            "size": os.path.getsize(path),
            "source": "file",
            "status": "active",
            "status_message": "",
            "success": 0,
            "type": channel,
            "unavailable": False,
        }
        record.update(overlay.get(channel, {}))
        files.append(record)
    return files


def run_login(login_mode, auth_store):
    """Stand in for `cli-proxy-api -<provider>-login`.

    Models what the real binary does from parley's side: print an authorize URL
    on stdout, then (on success) write a credential into the auth-dir. The four
    modes are the four ways #197's login could end.
    """
    url = ("https://claude.ai/oauth/authorize?client_id=fake&code=true"
           "&redirect_uri=http%3A%2F%2Flocalhost%3A54545%2Fcallback&state=fake")
    if login_mode == "port_taken":
        srv = HTTPServer(("127.0.0.1", 54545), BaseHTTPRequestHandler)
        sys.stdout.write(url + "\n")
        sys.stdout.flush()
        srv.serve_forever()
        return
    sys.stdout.write("Visit the following URL to continue authentication:\n")
    sys.stdout.write(url + "\n")
    sys.stdout.flush()
    if login_mode == "dies_early":
        sys.stderr.write("fake login: exiting non-zero before any callback\n")
        sys.exit(3)
    if login_mode == "hangs":
        time.sleep(300)
        return
    # success: write a credential after a beat, as a completed OAuth would
    time.sleep(0.5)
    if auth_store:
        os.makedirs(auth_store, exist_ok=True)
        with open(os.path.join(auth_store, "claude-fake@example.com.json"), "w") as f:
            json.dump({"type": "claude", "email": "fake@example.com"}, f)
    sys.exit(0)


def main():
    port, mode, mgmt_key, auth_store, error_mode = parse_args(sys.argv[1:])
    login_mode = os.environ.get("PARLEY_FAKE_LOGIN_MODE")
    if login_mode or any(a.endswith("-login") for a in sys.argv[1:]):
        run_login(login_mode or "success", auth_store)
        return
    if mode == "crash":
        sys.stderr.write("fake_cliproxy: crash mode — exiting\n")
        sys.exit(1)
    if port is None:
        sys.stderr.write("fake_cliproxy: no port given\n")
        sys.exit(2)

    served = {"first": False}  # for the `_once` transient modes

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_a):
            pass

        def _json(self, status, obj):
            body = json.dumps(obj).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _bearer(self):
            return (self.headers.get("Authorization") or "").replace("Bearer ", "", 1)

        # Real 7.1.71 error bodies, captured from ~/.cli-proxy-api/logs during
        # the #197 outage. Selected by --error-mode so the recovery ladder can be
        # driven end to end instead of through hand-built failure tables.
        ERRORS = {
            "no_auth": (503, {"type": "error", "error": {"type": "api_error", "message":
                "auth_unavailable: no auth available (providers=claude, model=claude-opus-4-8); "
                "check Claude auth/key session and cooldown state via /v0/management/auth-files"}}),
            "expired": (401, {"type": "error", "error": {"type": "authentication_error",
                "message": "OAuth access token has expired. Re-authenticate to continue."}}),
            "quota": (402, {"error": {"message": "payment_required", "type": "quota_error"}}),
        }

        def do_POST(self):
            length = int(self.headers.get("Content-Length") or 0)
            if length:
                self.rfile.read(length)
            # `<mode>_once` fails the FIRST request and succeeds afterwards —
            # a genuinely transient failure, which is what the recovery ladder's
            # retry rung is for. Modelling it here removes the alternative:
            # swapping servers mid-flight, which races the retry.
            base = error_mode[:-5] if error_mode.endswith("_once") else None
            if base is not None:
                if not served["first"]:
                    served["first"] = True
                    status, body = self.ERRORS[base]
                    self._json(status, body)
                    return
                self._json(200, {"id": "chatcmpl-fake", "object": "chat.completion",
                                 "choices": [{"index": 0, "finish_reason": "stop",
                                              "message": {"role": "assistant", "content": "ok"}}]})
                return
            if error_mode in self.ERRORS:
                status, body = self.ERRORS[error_mode]
                self._json(status, body)
                return
            # ok: a minimal non-streaming completion
            self._json(200, {"id": "chatcmpl-fake", "object": "chat.completion",
                             "choices": [{"index": 0, "finish_reason": "stop",
                                          "message": {"role": "assistant", "content": "ok"}}]})

        def do_GET(self):
            if mode == "slow":
                time.sleep(30)
                return
            if self.path.startswith("/v0/management/auth-files"):
                # No key rendered ⇒ the route was never registered. The real
                # binary 404s here, and parley treats that as repairable.
                if not mgmt_key:
                    self.send_response(404)
                    self.end_headers()
                    return
                if self._bearer() != mgmt_key:
                    self._json(401, {"error": "unauthorized"})
                    return
                self._json(200, {"files": read_auth_store(auth_store)})
                return
            if self.path.startswith("/v1/models"):
                if mode == "client_key_mismatch":
                    self._json(401, {"error": "unauthorized"})
                elif mode == "foreign":
                    self._json(200, {"hello": "i am not cliproxy"})
                elif mode == "needs_login":
                    self._json(200, {"object": "list", "data": []})
                else:  # healthy — a mixed-owner list so models-filtering is
                    # proven to discriminate (anthropic vs openai), not pass through
                    self._json(200, {"object": "list", "data": [
                        {"id": "claude-sonnet-4-6", "owned_by": "anthropic"},
                        {"id": "claude-opus-4-8", "owned_by": "anthropic"},
                        {"id": "gpt-5-codex", "owned_by": "openai"},
                    ]})
                return
            self.send_response(404)
            self.end_headers()

    HTTPServer(("127.0.0.1", port), Handler).serve_forever()


if __name__ == "__main__":
    main()
