# Parley-specific targets (Lua/Neovim plugin) — include from your project Makefile:
#   include Makefile.parley

# #409: admission belongs to the target, including alias/default entry.
ifeq ($(.DEFAULT_GOAL),)
.DEFAULT_GOAL := help-parley
endif
.NOTPARALLEL:
PARLEY_TEST_TARGETS := test test-unit test-integration test-compat test-spec test-changed perf perf-finder goldens fixtures check-couch-actors-live test-clean-env
PARLEY_TEST_BODIES := $(addprefix parley-test-body-,$(PARLEY_TEST_TARGETS))
PARLEY_TEST_DRY_RUN := $(findstring n,$(filter-out --%,$(firstword $(MAKEFLAGS))) $(filter -%,$(filter-out --%,$(MAKEFLAGS))))
PARLEY_TEST_LEASE_COMMAND = $(if $(PARLEY_TEST_DRY_RUN),,python3 scripts/test-run-lease.py --root "$(CURDIR)" --)
.PHONY: $(PARLEY_TEST_TARGETS) $(PARLEY_TEST_BODIES) parley-test-require-lease
$(PARLEY_TEST_TARGETS):
	+@$(PARLEY_TEST_LEASE_COMMAND) $(MAKE) --no-print-directory -f "$(firstword $(MAKEFILE_LIST))" parley-test-body-$@
# First prerequisite, before any body or its later dependency checks.
$(PARLEY_TEST_BODIES): parley-test-require-lease
parley-test-require-lease:
	@python3 scripts/test-run-lease.py --root "$(CURDIR)" --require

.PHONY: help-parley test test-unit test-integration test-compat test-spec test-changed perf perf-finder lint fixtures goldens model-check model-checker test-clean-env

help-parley:
	@printf '%s\n' \
	"Parley (Lua/Neovim):" \
	"  Test runs in the same checkout serialize; waiting runners print the lease holder." \
	"  make test             Run the whole suite" \
	"  make test-unit        Run unit tests" \
	"  make test-integration Run integration + arch tests" \
	"  make test-spec SPEC=  Run tests for a specific spec key" \
	"  make test-changed     Run tests for changed spec files" \
	"  make test-compat      Rerun unit + integration on the installed nvim if it differs (no suite lock)" \
	"  make check-fresh-clone Verify startup and tests in an isolated archive" \
	"  make check-vocabulary Compare shipped data to upstream (maintainer tools)" \
	"  make check-sdlc-conformance Compare real/fake sdlc resolver contracts (maintainers)" \
	"  make check-couch-registry-conformance Compare isolated real/fake registry contracts" \
	"  make check-couch-actors-live  Check the real couch --actors JSON against this thread (live)" \
	"  make perf             Report real headless chat-typing performance" \
	"  make perf-finder      Report ChatFinder materializer performance" \
	"  make lint             Run luacheck on lua/ and tests/" \
	"  make fixtures         Refresh SSE fixture files from real APIs" \
	"  make goldens          Regenerate the golden payload fixtures" \
	"  make model-check      Check latest model offerings from providers" \
	"  make test-clean-env   Remove the scratch root (and legacy in-repo dirs)" \
	""

# ── Test environment ─────────────────────────────────────────────────────────

PLENARY ?= $(HOME)/.local/share/nvim/lazy/plenary.nvim
REAL_HOME = $(HOME)

# The harness scratch trees live OUTSIDE $(CURDIR) on purpose — see
# atlas/infra/test_harness.md for why (#202). tests/arch/scratch_placement_spec.lua
# fails if this moves back into the tree.
#
# Keyed by the checkout so two worktrees of this repo do not share a root.
# `cksum` is POSIX; `shasum`/`sha256sum` are not both portable. TEST_ENV_KEY is
# `:=` so the subshell runs once per make invocation, not once per expansion of
# TEST_ENV.
REAL_TMP := $(patsubst %/,%,$(or $(TMPDIR),/tmp))
TEST_ENV_KEY := $(notdir $(CURDIR))-$(shell printf '%s' '$(CURDIR)' | cksum | cut -d' ' -f1)
TEST_ENV_ROOT ?= $(REAL_TMP)/parley-test-env/$(TEST_ENV_KEY)
TEST_HOME = $(TEST_ENV_ROOT)/home
TEST_XDG = $(TEST_ENV_ROOT)/xdg
TEST_TMP = $(TEST_ENV_ROOT)/tmp

# Pre-#202 in-repo locations. Still removed by test-clean-env so the migration
# completes itself for anyone who pulls this change onto a dirty checkout.
# Quoted individually at the use site: an unquoted list word-splits, and a
# checkout under a path with a space would make `rm -rf` target the fragments.
LEGACY_TEST_DIRS = "$(CURDIR)/.test-home" "$(CURDIR)/.test-xdg" "$(CURDIR)/.test-tmp"
# The nvim every spec process runs, children and grandchildren alike, found by
# PATH: scripts/test-nvim.sh prefers one whose LuaJIT has the arm64 mcode fix
# (#294). Probed on first use, once per make invocation, and only by targets
# that expand TEST_ENV.
TEST_NVIM_DIR = $(eval TEST_NVIM_DIR := $$(shell scripts/test-nvim.sh))$(TEST_NVIM_DIR)
# #365: every nvim starts through scripts/test-env.sh, which keeps only an
# allowlist of these names (no ambient COUCH_*, PAIR_* or terminal owner) and puts
# the sentinel couch/pair first on PATH. TEST_RUN is the prefix for one command.
TEST_ENV = PARLEY_TEST_ENV_ROOT="$(TEST_ENV_ROOT)" HOME="$(TEST_HOME)" XDG_CONFIG_HOME="$(TEST_XDG)/config" XDG_DATA_HOME="$(TEST_XDG)/data" XDG_STATE_HOME="$(TEST_XDG)/state" XDG_CACHE_HOME="$(TEST_XDG)/cache" TMPDIR="$(TEST_TMP)" NVIM_TEST_PLENARY="$(PLENARY)" $(if $(TEST_NVIM_DIR),PATH="$(TEST_NVIM_DIR):$$PATH")
# The real Couch thread reaches a spec only through check-couch-actors-live, the
# one target that sets PARLEY_LIVE_COUCH after this strip; every TEST_RUN drops it.
TEST_RUN = $(TEST_ENV) PARLEY_TEST_SENTINEL_LOG="$(SENTINEL_LOG)" env -u PARLEY_LIVE_COUCH "$(CURDIR)/scripts/test-env.sh"
# One log per target ($@), so concurrent targets never truncate each other's evidence.
SENTINEL_LOG = $(TEST_ENV_ROOT)/sentinel-$@.log
# The sentinel gate (#365): a call to the real couch/pair that no fake shadowed.
SENTINEL_CHECK = if [ -s "$(SENTINEL_LOG)" ]; then echo "test sentinel (\#365): a spec reached the real CLI (cli, cwd, argv):" >&2; sed "s/^/  /" "$(SENTINEL_LOG)" >&2; false; fi

# The orphan gate (#220). `before` reaps what an earlier interrupted run left;
# `after` reports this run's survivors and fails. One owner, so a new test target
# gets the gate by adding a line rather than restating the command.
ORPHANS = python3 scripts/reap-test-orphans.py --root "$(CURDIR)"

define PREP_TEST_ENV
mkdir -p "$(TEST_HOME)" "$(TEST_XDG)/config" "$(TEST_XDG)/data" "$(TEST_XDG)/state" "$(TEST_XDG)/cache" "$(TEST_TMP)" && : > "$(SENTINEL_LOG)" && $(ORPHANS) --phase before
endef

# Run the whole suite. Execution model (parallel fan-out, per-spec processes,
# scratch placement) is documented in atlas/infra/test_harness.md — restating it
# here is how these comments went stale.
#
# Recursive $(MAKE) rather than prerequisites: prerequisite order is only
# guaranteed under serial make, and `make -j test` could otherwise schedule the
# scratch wipe alongside — or into the middle of — a running suite.
parley-test-body-test:
	@$(MAKE) --no-print-directory test-clean-env
	@$(MAKE) --no-print-directory lint
	@$(MAKE) --no-print-directory test-unit
	@$(MAKE) --no-print-directory test-integration
	@$(MAKE) --no-print-directory test-compat

# #379: the suite above runs the nvim test-nvim.sh prefers (0.12 for its LuaJIT
# fix), but the operator edits with whatever is first on PATH. When that is a
# different version, run unit and integration again on it, so a break that only
# the installed editor has fails `make test` (and the recorded suite). An
# installed editor below version_support.MINIMUM fails with its refusal.
# Skipped when the versions match or no nvim is on PATH.
parley-test-body-test-compat:
	@installed="$$(scripts/test-nvim.sh --installed)"; preferred="$$(scripts/test-nvim.sh)"; \
	if [ -z "$$installed" ] || [ -z "$$preferred" ]; then echo "compat: no installed nvim to compare; skipped"; exit 0; fi; \
	iv="$$("$$installed/nvim" --version | head -1)"; pv="$$("$$preferred/nvim" --version | head -1)"; \
	if [ "$$iv" = "$$pv" ]; then echo "compat: the installed $$iv is the runtime tested above; skipped"; exit 0; fi; \
	scripts/test-nvim.sh --supported "$$installed" || { echo "compat: the installed nvim ($$installed) is unsupported" >&2; exit 1; }; \
	echo "compat: also testing the installed $$iv ($$installed/nvim)"; \
	PARLEY_TEST_NVIM="$$installed/nvim" $(MAKE) --no-print-directory test-unit test-integration

# Number of parallel test processes (override with JOBS=N).
JOBS ?= 8

# Per-file test runner. Captures the file's output; prints `PASS: <path> (<secs>s)` on
# success or a labelled `===FAIL: <path> (<secs>s)===` block (with indented output) on
# failure; appends the failing path to $FAILED_LOG so the recipe can print a
# reliable summary after xargs finishes. Single-line PASS writes are atomic;
# the FAIL block is best-effort across parallel jobs but the end-of-run
# summary is authoritative either way. With PARLEY_TEST_JITSTAT=1, PASS and FAIL
# also show each spec process's final LuaJIT line, grandchildren included
# (tests/helpers/jit_watch.lua, #294).
RUN_SPEC = sh -c 'jitstat() { [ -s "$$1" ] && awk "{last[\$$2]=\$$0} END {for (p in last) print \"  \" last[p]}" "$$1"; true; }; out=$$(mktemp "$$TMPDIR/parley-test.XXXXXX"); t0=$$(date +%s); export PARLEY_TEST_JITSTAT_LOG="$$out.jit"; if env -u PARLEY_LIVE_COUCH "$(CURDIR)/scripts/test-env.sh" nvim -n --headless --noplugin -u "$(CURDIR)/tests/minimal_init.vim" -c "PlenaryBustedFile $$1" -c "qa!" >"$$out" 2>&1; then printf "PASS: %s (%ss)\n" "$$1" $$(( $$(date +%s) - t0 )); jitstat "$$out.jit"; rm -f "$$out" "$$out.jit"; else { printf "===FAIL: %s (%ss)===\n" "$$1" $$(( $$(date +%s) - t0 )); sed "s/^/  /" "$$out"; jitstat "$$out.jit"; }; rm -f "$$out.jit"; echo "$$1" >> "$$FAILED_LOG"; rm -f "$$out"; exit 1; fi' _

# Each spec file runs in its own Neovim process.
parley-test-body-test-unit:
	@$(PREP_TEST_ENV)
	@export $(TEST_ENV) PARLEY_TEST_SENTINEL_LOG="$(SENTINEL_LOG)"; \
	FAILED_LOG=$$(mktemp "$$TMPDIR/parley-failed.XXXXXX"); export FAILED_LOG; \
	find tests/unit -name '*_spec.lua' | sort | \
	  xargs -P $(JOBS) -I {} $(RUN_SPEC) {}; \
	rc=0; \
	if [ -s "$$FAILED_LOG" ]; then \
	  printf '\n=== Failed unit test files ===\n'; \
	  sort -u "$$FAILED_LOG"; \
	  rc=1; \
	fi; \
	rm -f "$$FAILED_LOG"; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Integration + arch specs, same per-file process fan-out.
parley-test-body-test-integration:
	@$(PREP_TEST_ENV)
	@export $(TEST_ENV) PARLEY_TEST_SENTINEL_LOG="$(SENTINEL_LOG)"; \
	FAILED_LOG=$$(mktemp "$$TMPDIR/parley-failed.XXXXXX"); export FAILED_LOG; \
	find tests/integration tests/arch -name '*_spec.lua' | sort | \
	  xargs -P $(JOBS) -I {} $(RUN_SPEC) {}; \
	rc=0; \
	if [ -s "$$FAILED_LOG" ]; then \
	  printf '\n=== Failed integration test files ===\n'; \
	  sort -u "$$FAILED_LOG"; \
	  rc=1; \
	fi; \
	rm -f "$$FAILED_LOG"; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Run tests mapped to one spec key/path from atlas/traceability.yaml.
# Example: make test-spec SPEC=chat/lifecycle
parley-test-body-test-spec:
	@if [ -z "$(SPEC)" ]; then \
		echo "Usage: make test-spec SPEC=chat/lifecycle"; \
		exit 1; \
	fi
	@$(PREP_TEST_ENV) || exit $$?; \
	tests="$$(scripts/spec_test_map.sh list-tests "$(SPEC)")"; \
	if [ -z "$$tests" ]; then \
		echo "No tests mapped for spec: $(SPEC)"; \
		echo "Update atlas/traceability.yaml to add mappings."; \
		exit 1; \
	fi; \
	rc=0; \
	for test_file in $$tests; do \
		echo "Running $$test_file"; \
		$(TEST_RUN) nvim -n --headless --noplugin -u "$(CURDIR)/tests/minimal_init.vim" \
		  -c "PlenaryBustedFile $$test_file" \
		  -c "qa!" || rc=1; \
	done; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Run tests mapped to changed spec files under atlas/*/*.md.
# Uses tracked and untracked file changes since feature-branch base
# (default base ref: remote/main, fallback origin/main, then main).
parley-test-body-test-changed:
	@$(PREP_TEST_ENV) || exit $$?; \
	scripts/spec_test_map.sh base-info; \
	changed_specs="$$(scripts/spec_test_map.sh list-changed-specs)"; \
	if [ -z "$$changed_specs" ]; then \
		echo "No changed spec files under atlas/*/*.md"; \
		exit 0; \
	fi; \
	echo "Changed specs:"; \
	printf '%s\n' "$$changed_specs"; \
	missing=0; \
	for spec_path in $$changed_specs; do \
		if ! scripts/spec_test_map.sh has-mapping "$$spec_path"; then \
			echo "No traceability entry for $$spec_path"; \
			missing=1; \
		fi; \
	done; \
	if [ "$$missing" -ne 0 ]; then \
		echo "Please update atlas/traceability.yaml for missing mappings."; \
		exit 1; \
	fi; \
	all_tests="$$(scripts/spec_test_map.sh list-tests-from-changed-specs)"; \
	if [ -z "$$all_tests" ]; then \
		echo "No mapped tests for changed specs (all may have tests: [])."; \
		exit 0; \
	fi; \
	lua_tests=""; sh_tests=""; unknown=""; \
	for f in $$all_tests; do \
		case "$$f" in \
			*.lua) lua_tests="$$lua_tests $$f" ;; \
			*.sh)  sh_tests="$$sh_tests $$f" ;; \
			*)     unknown="$$unknown $$f" ;; \
		esac; \
	done; \
	if [ -n "$$unknown" ]; then \
		echo "Unknown test types:$$unknown"; \
		exit 1; \
	fi; \
	sh_pids=""; sh_fail=0; rc=0; \
	for test_file in $$sh_tests; do \
		echo "Running $$test_file (background)"; \
		bash "$$test_file" & \
		sh_pids="$$sh_pids $$!"; \
	done; \
	if [ -n "$$lua_tests" ]; then \
		for test_file in $$lua_tests; do \
			echo "Running $$test_file"; \
			$(TEST_RUN) nvim -n --headless --noplugin -u "$(CURDIR)/tests/minimal_init.vim" \
			  -c "PlenaryBustedFile $$test_file" \
			  -c "qa!" || rc=1; \
		done; \
	fi; \
	for pid in $$sh_pids; do \
		wait "$$pid" || sh_fail=1; \
	done; \
	if [ "$$sh_fail" -ne 0 ]; then \
		echo "One or more shell tests failed"; \
		rc=1; \
	fi; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Report-only real-Neovim chat typing benchmark. Elapsed timings never gate CI;
# scenario validity and structural work accounting still fail loudly.
PERF_OUTPUT ?= $(TEST_TMP)/perf/parley-chat-typing.json
parley-test-body-perf:
	@$(PREP_TEST_ENV) || exit $$?; \
	rc=0; \
	$(TEST_ENV) PERF_OUTPUT="$(PERF_OUTPUT)" PARLEY_TEST_SENTINEL_LOG="$(SENTINEL_LOG)" env -u PARLEY_LIVE_COUCH "$(CURDIR)/scripts/test-env.sh" nvim -n --headless --noplugin -u "$(CURDIR)/tests/minimal_init.vim" \
	  -c "lua require('tests.perf.chat_typing').start()" || rc=1; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Run static analysis for Lua code and tests.
lint:
	@command -v luacheck >/dev/null 2>&1 || { \
		echo "luacheck not found. Install with: luarocks install luacheck"; \
		exit 1; \
	}
	@luacheck lua tests packaging

# Report-only ChatFinder materializer benchmark, under the isolated TEST_ENV.
parley-test-body-perf-finder:
	@$(PREP_TEST_ENV) || exit $$?; \
	rc=0; \
	$(TEST_RUN) nvim --headless -u "$(CURDIR)/tests/minimal_init.vim" -l tests/perf_chat_finder.lua || rc=1; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Regenerate tests/fixtures/golden_payloads/*.json. Under TEST_ENV like every
# harness run: tests/minimal_init.vim refuses a non-isolated environment (#342).
parley-test-body-goldens:
	@$(PREP_TEST_ENV) || exit $$?; \
	rc=0; \
	$(TEST_RUN) nvim --headless --noplugin -u "$(CURDIR)/tests/minimal_init.vim" \
	  -c "luafile scripts/refresh_goldens.lua" \
	  -c "qa!" || rc=1; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Refresh SSE fixture files from real APIs.
# Requires ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLEAI_API_KEY in environment.
parley-test-body-fixtures:
	@$(PREP_TEST_ENV) || exit $$?; \
	rc=0; \
	PARLEY_TEST_ENV_PASS="ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLEAI_API_KEY" $(TEST_RUN) nvim --headless --noplugin -u "$(CURDIR)/tests/minimal_init.vim" \
	  -c "luafile scripts/record_fixtures.lua" \
	  -c "qa!" || rc=1; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

# Check latest model offerings from each provider and optionally update fixture models.
# Requires API keys in environment.
model-check:
	@bash scripts/model_check.sh

# Backward-compatible alias.
model-checker: model-check

# Removes only the leaves PREP_TEST_ENV itself creates — never $(TEST_ENV_ROOT)
# verbatim. TEST_ENV_ROOT is a documented override, this target now runs first in
# every `make test`, and command-line overrides propagate to the sub-make, so
# `make test TEST_ENV_ROOT=/some/where` would otherwise `rm -rf /some/where`.
# The rule: delete paths the harness constructs and can name literally, each
# quoted individually so a path containing a space stays one word.
parley-test-body-test-clean-env:
	@rm -rf "$(TEST_HOME)" "$(TEST_XDG)" "$(TEST_TMP)" $(LEGACY_TEST_DIRS)

# Public contributors may keep Plenary anywhere; normal tests need no ariadne.
.PHONY: check-test-deps check-vocabulary check-fresh-clone check-sdlc-conformance check-couch-registry-conformance check-couch-actors-live
check-test-deps:
	@test -r "$(PLENARY)/plugin/plenary.vim" || { \
	  echo "Missing plenary.nvim. Clone nvim-lua/plenary.nvim, then run make test PLENARY=/absolute/path/to/plenary.nvim" >&2; exit 1; }

$(addprefix parley-test-body-,test-unit test-integration test-spec test-changed): check-test-deps

check-vocabulary:
	@scripts/check-vocabulary.sh

check-fresh-clone:
	@PLENARY="$(PLENARY)" scripts/check-fresh-clone.sh --full --worktree

check-sdlc-conformance:
	@command -v sdlc >/dev/null 2>&1 || { echo "Install sdlc to run the maintainer conformance check" >&2; exit 1; }
	@sdlc --help >/dev/null
	@sdlc issue new --help >/dev/null
	@python3 scripts/check-sdlc-resolve-conformance.py

# Opt-in diagnostic only; requires Couch's explicit singleton-isolation support.
# The live --actors conformance check (#365): couch_spec ALONE, with the slot's
# real Couch thread (PARLEY_LIVE_COUCH carries it through scripts/test-env.sh).
# Never part of `make test`, whose runner strips the flag.
# #366: the real CLI refuses the isolated XDG_DATA_HOME (it conflicts with the
# store COUCH_STORE_DIR selects), so its one call gets the operator's data home.
LIVE_COUCH_DATA_HOME = $(or $(XDG_DATA_HOME),$(REAL_HOME)/.local/share)
parley-test-body-check-couch-actors-live:
	@$(PREP_TEST_ENV) || exit $$?; \
	rc=0; \
	$(TEST_ENV) PARLEY_TEST_SENTINEL_LOG="$(SENTINEL_LOG)" PARLEY_LIVE_COUCH=1 PARLEY_LIVE_COUCH_DATA_HOME="$(LIVE_COUCH_DATA_HOME)" "$(CURDIR)/scripts/test-env.sh" nvim -n --headless --noplugin -u "$(CURDIR)/tests/minimal_init.vim" \
	  -c "PlenaryBustedFile tests/unit/couch_spec.lua" -c "qa!" || rc=1; \
	$(ORPHANS) --phase after || rc=1; \
	$(SENTINEL_CHECK) || rc=1; \
	exit $$rc

check-couch-registry-conformance:
	@python3 scripts/check-couch-registry-conformance.py
